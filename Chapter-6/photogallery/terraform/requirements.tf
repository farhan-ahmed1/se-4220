// Provider + Terraform version pinning. The assignment names this file
// "requirements.tf" specifically; in idiomatic Terraform it would normally
// be "versions.tf".

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 4.84"
    }
    archive = {
      source  = "hashicorp/archive"
      version = "~> 2.4"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}
