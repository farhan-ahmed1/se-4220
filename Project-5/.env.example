# Copy this file to `.env` for local development. Never commit `.env`.

# --- Cloud SQL MySQL ---
DB_HOSTNAME=127.0.0.1
DB_USERNAME=root
DB_PASSWORD=changeme
DB_NAME=classifieds_db
DB_PORT=3306

# --- Google Cloud Storage ---
GCS_BUCKET=se4220-classifieds-bucket
# Path to the service-account JSON. Only needed locally; on App Engine the
# default service account is used automatically.
GOOGLE_APPLICATION_CREDENTIALS=gcp-key.json

# --- Flask ---
FLASK_SECRET_KEY=change-me-to-a-random-string
